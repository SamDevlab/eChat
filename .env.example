NODE_ENV=development
# Local pilot default: use the isolated echat_test database for both app and integration tests.
DATABASE_ENV=TEST
DATABASE_URL=postgres://user:password@127.0.0.1:5432/echat_test
DATABASE_URL_TEST=postgres://user:password@127.0.0.1:5432/echat_test
ECHAT_ALLOW_DEMO_SEED=0
APP_URL=http://localhost:5173
PUBLIC_APP_URL=
PUBLIC_URL_PERSISTENT=0
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=echat_session
SESSION_TTL_HOURS=168
MESSAGING_PROVIDER=mock
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_INBOX_ID=
CHATWOOT_EXPECTED_WEBHOOK_URL=
# 1 = falha se o webhook esperado não estiver registrado. A checagem continua read-only.
CHATWOOT_REQUIRE_WEBHOOK_MATCH=0
INTEGRATION_ENCRYPTION_KEY=
ECHAT_OUTBOUND_MODE=disabled
# Pilot entries are integration id + external conversation id, comma-separated.
ECHAT_OUTBOUND_PILOT_CONVERSATIONS=

# Production deployment (set real values outside Git):
# NODE_ENV=production
# DATABASE_ENV=PRODUCTION
# DATABASE_URL=postgres://user:password@postgres-host:5432/echat
# APP_URL=https://echat.example.com
# PUBLIC_APP_URL=https://echat.example.com
# PUBLIC_URL_PERSISTENT=1
# ECHAT_DOMAIN=echat.example.com
# SESSION_SECRET=<at least 32 random characters>
# INTEGRATION_ENCRYPTION_KEY=<64 hex characters or base64 for exactly 32 bytes>
