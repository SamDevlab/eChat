{
  "name": "@echat/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:seed": "tsx --env-file=../../.env src/seed.ts",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "test:integration": "vitest run src/integration.test.ts",
    "test:live": "tsx --env-file=../../.env src/live-smoke.ts"
  },
  "dependencies": {
    "@echat/db": "0.1.0",
    "@echat/shared": "0.1.0",
    "drizzle-orm": "^0.38.3",
    "@types/node": "^22.10.2",
    "zod": "^3.24.1"
  }
}
